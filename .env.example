# ---------------------------------------------------------------
# Учебная доска — переменные окружения.
# Скопируйте в .env и заполните. Файл .env не коммитится.
# Полный список будет дополнен на этапе 9 (развёртывание).
# ---------------------------------------------------------------

# PostgreSQL (используется Prisma)
POSTGRES_USER=doska
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=doska
DATABASE_URL=postgresql://doska:change_me_strong_password@localhost:5432/doska?schema=public

# Режим и сеть бэкенда
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true — бэкенд за Nginx (доверять X-Forwarded-For для rate limiting и журнала)
TRUST_PROXY=true
# Флаг Secure у cookie (по умолчанию true при NODE_ENV=production;
# для локальной разработки по http поставьте false)
COOKIE_SECURE=

# Подпись access-токенов (JWT HS256): случайная строка не короче 32 символов
# (openssl rand -base64 48). Refresh-токены — случайные, секрет для них не нужен.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Хеширование паролей argon2id (память в КиБ, число проходов)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3

# Защита входа
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=60

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=doska
S3_ACCESS_KEY=doska
S3_SECRET_KEY=change_me_minio_secret

# Первый администратор (создаётся сид-скриптом, если в БД нет администраторов)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Администратор

# Публичный адрес сайта (проверка Origin для CSRF и WebSocket).
# Несколько адресов — через запятую.
PUBLIC_ORIGIN=https://doska.example.ru

# Распознавание рукописных формул (пусто = функция выключена)
FORMULA_OCR_URL=
FORMULA_OCR_API_KEY=
