# ---------------------------------------------------------------
# Учебная доска — переменные окружения.
# Скопируйте в .env и заполните. Файл .env не коммитится.
# В Docker Compose (docker-compose.yml) адреса базы, хранилища и сети
# сервера задаются самим Compose — здесь их менять не нужно.
# ---------------------------------------------------------------

# Адрес сайта (Docker Compose).
# С доменом: DOMAIN=doska.school.ru, PUBLIC_ORIGIN=https://doska.school.ru,
#   COOKIE_SECURE=true, затем ./deploy/scripts/https.sh — сертификат Let's Encrypt.
# Без домена (локальная сеть): DOMAIN пустой, PUBLIC_ORIGIN=http://192.168.1.10,
#   COOKIE_SECURE=false — вход по IP сервера.
DOMAIN=
# Почта для Let's Encrypt (уведомления об истечении сертификата).
LETSENCRYPT_EMAIL=
# Порты на сервере (по умолчанию 80 и 443).
HTTP_PORT=80
HTTPS_PORT=443
# Дополнительные сервисы Docker Compose: tls — продление сертификата,
# ocr — распознавание рукописных формул (через запятую). Их поднимает обычный
# «docker compose up -d».
COMPOSE_PROFILES=
# Зеркало движков Prisma для сборки образов, если binaries.prisma.sh недоступен
# (обрыв «ECONNRESET» в @prisma/engines), например
# https://registry.npmmirror.com/-/binary/prisma. Пусто — основной адрес.
PRISMA_ENGINES_MIRROR=

# PostgreSQL (используется Prisma)
POSTGRES_USER=doska
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=doska
DATABASE_URL=postgresql://doska:change_me_strong_password@localhost:5432/doska?schema=public

# Режим и сеть бэкенда
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true — бэкенд за Nginx (доверять X-Forwarded-For для rate limiting и журнала)
TRUST_PROXY=true
# Флаг Secure у cookie (по умолчанию true при NODE_ENV=production;
# для локальной разработки по http поставьте false)
COOKIE_SECURE=

# Подпись access-токенов (JWT HS256): случайная строка не короче 32 символов
# (openssl rand -base64 48). Refresh-токены — случайные, секрет для них не нужен.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Хеширование паролей argon2id (память в КиБ, число проходов)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3

# Защита входа
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=60

# Хранилище файлов (картинки, PDF). Пусто — файлы на диске: каталог UPLOADS_DIR
# (в Docker Compose — том uploads). Задан S3_ENDPOINT — S3-совместимое хранилище
# (MinIO и т. п.), например http://minio:9000.
UPLOADS_DIR=./data/uploads
UPLOAD_MAX_IMAGE_MB=15
UPLOAD_MAX_PDF_MB=50
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=doska
S3_ACCESS_KEY=doska
S3_SECRET_KEY=change_me_minio_secret

# Первый администратор (создаётся сид-скриптом, если в БД нет администраторов)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Администратор

# Публичный адрес сайта (проверка Origin для CSRF и WebSocket).
# Несколько адресов — через запятую.
PUBLIC_ORIGIN=https://doska.example.ru

# Распознавание рукописных формул (пусто = функция выключена).
# Свой сервис: docker compose --profile ocr up -d formula-ocr, затем
# FORMULA_OCR_URL=http://127.0.0.1:8502/predict. Подходит и внешний сервис
# с тем же протоколом (POST PNG -> JSON {"latex": "..."}).
FORMULA_OCR_URL=
# Ключ доступа (заголовок Authorization: Bearer …); тот же ключ получает контейнер.
FORMULA_OCR_API_KEY=
FORMULA_OCR_TIMEOUT_SECONDS=30
