# Сайт по HTTP: локальная сеть (вход по IP) или до получения сертификата.
# Каталог /.well-known/acme-challenge нужен certbot для выпуска сертификата.
# По HTTP заголовок HSTS не отправляется (пустое значение).
map $scheme $hsts {
    default "";
}

server {
    # Только IPv4: в контейнерах Docker IPv6 по умолчанию выключен (подключения
    # по IPv6 к серверу пробрасывает сам Docker).
    listen 80 default_server;
    server_name _;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/doska/locations.conf;
}
