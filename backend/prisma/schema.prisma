// =====================================================================
//  «Учебная доска» — схема базы данных (PostgreSQL + Prisma)
//
//  Принципы:
//  * Идентификаторы — UUID (не раскрывают количество записей).
//  * Содержимое доски хранится НЕ в реляционных таблицах, а как бинарное
//    состояние Yjs-документа (BoardDocument.state) + журнал инкрементальных
//    обновлений (BoardUpdate), который периодически сжимается в снимок.
//  * Права доступа к доскам вычисляются из BoardMember (прямой доступ),
//    BoardClassAccess (доступ классу целиком) и ChalkGrant («мел»).
//  * Пользователи удаляются «мягко» (deletedAt), чтобы журнал действий и
//    авторство объектов оставались ссылочно целостными.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
//  Пользователи и сессии
// ---------------------------------------------------------------------

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Логин хранится в нижнем регистре; уникален среди всех пользователей.
  /// При удалении логин переименовывается в "<login>#deleted#<epoch>",
  /// чтобы его можно было выдать заново.
  login              String    @unique @db.VarChar(64)
  fullName           String    @db.VarChar(200)
  role               UserRole
  /// argon2id-хеш. Сам пароль нигде не хранится и не логируется.
  passwordHash       String
  /// true — пароль временный (создан администратором/сброшен), при входе
  /// пользователь обязан сменить его, прочие API до смены недоступны.
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?
  isBlocked          Boolean   @default(false)
  blockedAt          DateTime?
  blockedReason      String?   @db.VarChar(500)
  /// Счётчик неудачных входов подряд и временная блокировка учётной записи
  /// (дополнение к rate limiting по IP).
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Цвет курсора/подписи на доске (#RRGGBB); назначается при создании.
  color              String    @default("#3b82f6") @db.VarChar(7)
  /// Пользовательские настройки интерфейса: тема, закреплённые инструменты,
  /// режим «только перо» и т.п. Валидируются zod-схемой на сервере.
  preferences        Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdById        String?   @db.Uuid
  createdBy          User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]    @relation("UserCreatedBy")

  refreshTokens     RefreshToken[]
  classMemberships  ClassMember[]
  ownedBoards       Board[]            @relation("BoardOwner")
  boardMemberships  BoardMember[]
  chalkGrants       ChalkGrant[]       @relation("ChalkHolder")
  chalkGrantedByMe  ChalkGrant[]       @relation("ChalkGrantedBy")
  folders           Folder[]
  assignments       Assignment[]       @relation("AssignmentTeacher")
  assignmentWorks   AssignmentWork[]   @relation("AssignmentStudent")
  boardVersions     BoardVersion[]
  assets            Asset[]
  templates         Template[]         @relation("TemplateAuthor")
  templateShares    TemplateShare[]
  auditLogsAsActor  AuditLog[]         @relation("AuditActor")
  boardsAccessGrant BoardClassAccess[]

  @@index([role])
  @@index([fullName])
  @@index([deletedAt])
}

/// Refresh-токен. В БД хранится только SHA-256 от токена.
/// Ротация: при каждом обновлении выдаётся новый токен той же «семьи»
/// (familyId), старый помечается revokedAt + replacedById. Повторное
/// использование уже отозванного токена = признак кражи → отзывается вся семья.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @db.Char(64)
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(50)
  replacedById String?   @db.Uuid
  userAgent    String?   @db.VarChar(400)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------
//  Классы / группы
// ---------------------------------------------------------------------

model Class {
  id           String    @id @default(uuid()) @db.Uuid
  /// Например «9 «А»», «Физтех-кружок», «МА-101».
  name         String    @db.VarChar(100)
  description  String?   @db.VarChar(1000)
  /// Учебный год, например «2026/2027» (для фильтрации и архивации).
  academicYear String?   @db.VarChar(9)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members     ClassMember[]
  boardAccess BoardClassAccess[]
  assignments Assignment[]

  @@unique([name, academicYear])
}

enum ClassMemberRole {
  STUDENT
  TEACHER
}

/// Ученик может состоять в нескольких группах (основной класс + кружки),
/// учитель может быть назначен в несколько классов.
model ClassMember {
  classId   String          @db.Uuid
  class     Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ClassMemberRole
  createdAt DateTime        @default(now())

  @@id([classId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------
//  Доски
// ---------------------------------------------------------------------

/// Тип доски определяет набор правил доступа (см. packages/shared/src/permissions).
enum BoardKind {
  /// Обычная доска урока учителя.
  LESSON
  /// Личная доска-конспект ученика.
  NOTEBOOK
  /// Индивидуальная копия задания, выданная ученику.
  ASSIGNMENT_WORK
  /// Содержимое шаблона библиотеки (и доска-шаблон для раздачи задания).
  TEMPLATE
}

/// Режим доски урока.
enum BoardMode {
  /// Пишет только учитель.
  LECTURE
  /// Пишут все допущенные.
  COLLABORATIVE
  /// Пишут учитель и ученики, получившие «мел».
  SELECTIVE
}

model Folder {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?  @db.Uuid
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  boards    Board[]

  @@unique([ownerId, parentId, name])
  @@index([ownerId])
}

model Board {
  id                 String    @id @default(uuid()) @db.Uuid
  kind               BoardKind @default(LESSON)
  title              String    @db.VarChar(300)
  description        String?   @db.VarChar(2000)
  ownerId            String    @db.Uuid
  owner              User      @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  folderId           String?   @db.Uuid
  folder             Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  mode               BoardMode @default(LECTURE)
  /// Настройки доски (zod-схема BoardSettings в @doska/shared):
  /// allowStudentsEditOthers, allowStudentLaser, defaultBackground и т.д.
  settings           Json      @default("{}")
  /// Для NOTEBOOK: показывать ли конспект учителям класса.
  sharedWithTeachers Boolean   @default(false)
  /// Ключ миниатюры в MinIO (обновляется сервером не чаще раза в минуту).
  thumbnailKey       String?   @db.VarChar(300)
  thumbnailUpdatedAt DateTime?
  /// Счётчики для списков без загрузки Yjs-документа.
  objectCount        Int       @default(0)
  pageCount          Int       @default(1)
  lastActivityAt     DateTime  @default(now())
  archivedAt         DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  document              BoardDocument?
  updates               BoardUpdate[]
  versions              BoardVersion[]
  members               BoardMember[]
  classAccess           BoardClassAccess[]
  chalkGrants           ChalkGrant[]
  assets                Asset[]
  assignmentWork        AssignmentWork?
  /// Задания, для которых эта доска — шаблон.
  assignmentsAsTemplate Assignment[]       @relation("AssignmentTemplateBoard")
  template              Template?

  @@index([ownerId, deletedAt])
  @@index([folderId])
  @@index([kind])
  @@index([title])
  @@index([lastActivityAt])
}

/// Текущее состояние Yjs-документа доски (сжатый снимок).
/// Вынесено в отдельную таблицу, чтобы списки досок не тянули бинарные данные.
model BoardDocument {
  boardId       String   @id @db.Uuid
  board         Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Y.encodeStateAsUpdate(doc) — полное состояние.
  state         Bytes
  /// Y.encodeStateVector(doc) — для быстрых сравнений.
  stateVector   Bytes
  /// Номер последнего BoardUpdate.seq, вошедшего в снимок.
  compactedSeq  BigInt   @default(0)
  sizeBytes     Int      @default(0)
  /// Версия формата документа (миграции структуры Yjs-документа).
  schemaVersion Int      @default(1)
  updatedAt     DateTime @updatedAt
}

/// Журнал принятых (уже проверенных сервером) инкрементальных обновлений
/// между снимками. Пишется пакетами раз в ~1 с; гарантирует, что при
/// падении процесса теряется не более секунды работы. Сжимается в
/// BoardDocument каждые 60 с или 500 записей.
model BoardUpdate {
  seq       BigInt   @id @default(autoincrement())
  boardId   String   @db.Uuid
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  data      Bytes
  createdAt DateTime @default(now())

  @@index([boardId, seq])
}

enum BoardVersionReason {
  /// Автоматический снимок (каждые 10 мин активного редактирования).
  AUTO
  /// Создан учителем вручную с подписью.
  MANUAL
  /// Создан автоматически перед восстановлением другой версии.
  BEFORE_RESTORE
  /// Создан автоматически перед массовой очисткой (следы учеников и т.п.).
  BEFORE_CLEAR
}

model BoardVersion {
  id           String             @id @default(uuid()) @db.Uuid
  boardId      String             @db.Uuid
  board        Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  reason       BoardVersionReason
  label        String?            @db.VarChar(200)
  createdById  String?            @db.Uuid
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  state        Bytes
  objectCount  Int                @default(0)
  sizeBytes    Int                @default(0)
  thumbnailKey String?            @db.VarChar(300)
  createdAt    DateTime           @default(now())

  @@index([boardId, createdAt])
}

enum BoardMemberRole {
  /// Соведущий учитель: те же права, что у владельца, кроме удаления доски.
  CO_TEACHER
  /// Ученик, допущенный индивидуально.
  STUDENT
  /// Только просмотр (например, ассистент или гость-учитель).
  VIEWER
}

/// Прямой доступ пользователя к доске (в дополнение к доступу классу).
model BoardMember {
  boardId   String          @db.Uuid
  board     Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BoardMemberRole
  createdAt DateTime        @default(now())

  @@id([boardId, userId])
  @@index([userId])
}

/// Доступ к доске всему классу: состав вычисляется динамически, поэтому
/// ученики, добавленные в класс позже, тоже видят доску.
model BoardClassAccess {
  boardId     String   @db.Uuid
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  classId     String   @db.Uuid
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  grantedById String?  @db.Uuid
  grantedBy   User?    @relation(fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@id([boardId, classId])
  @@index([classId])
}

/// «Мел»: право рисовать в режиме SELECTIVE. Хранится в БД, чтобы
/// переживать переподключения и перезапуск сервера.
model ChalkGrant {
  boardId     String   @db.Uuid
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  user        User     @relation("ChalkHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?  @db.Uuid
  grantedBy   User?    @relation("ChalkGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@id([boardId, userId])
}

// ---------------------------------------------------------------------
//  Задания (раздача копий доски-шаблона)
// ---------------------------------------------------------------------

model Assignment {
  id              String    @id @default(uuid()) @db.Uuid
  title           String    @db.VarChar(300)
  instructions    String?   @db.VarChar(5000)
  teacherId       String    @db.Uuid
  teacher         User      @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  /// Доска-шаблон (kind = TEMPLATE или LESSON), с которой делаются копии.
  templateBoardId String    @db.Uuid
  templateBoard   Board     @relation("AssignmentTemplateBoard", fields: [templateBoardId], references: [id], onDelete: Restrict)
  /// Класс, которому выдано задание (null — выдано выбранным ученикам).
  classId         String?   @db.Uuid
  class           Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  dueAt           DateTime?
  /// После закрытия ученики не могут редактировать свои работы.
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  works AssignmentWork[]

  @@index([teacherId])
  @@index([classId])
}

enum AssignmentWorkStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
}

model AssignmentWork {
  id           String               @id @default(uuid()) @db.Uuid
  assignmentId String               @db.Uuid
  assignment   Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String               @db.Uuid
  student      User                 @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  /// Копия доски-шаблона (kind = ASSIGNMENT_WORK), принадлежит учителю,
  /// ученик получает к ней доступ через правила BoardKind.ASSIGNMENT_WORK.
  boardId      String               @unique @db.Uuid
  board        Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status       AssignmentWorkStatus @default(NOT_STARTED)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  grade        String?              @db.VarChar(20)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------
//  Файлы (картинки, PDF) в MinIO
// ---------------------------------------------------------------------

enum AssetKind {
  IMAGE
  PDF
  /// Растеризованная страница PDF (используется как фон страницы доски).
  PDF_PAGE
  THUMBNAIL
}

model Asset {
  id           String    @id @default(uuid()) @db.Uuid
  kind         AssetKind
  ownerId      String    @db.Uuid
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  boardId      String?   @db.Uuid
  board        Board?    @relation(fields: [boardId], references: [id], onDelete: SetNull)
  /// Ключ объекта в бакете: assets/<yyyy>/<mm>/<uuid>.<ext>
  storageKey   String    @unique @db.VarChar(300)
  /// MIME, определённый по сигнатуре файла (а не по заголовку клиента).
  mime         String    @db.VarChar(100)
  sizeBytes    Int
  sha256       String    @db.Char(64)
  width        Int?
  height       Int?
  pageCount    Int?
  /// Для PDF_PAGE — исходный PDF и номер страницы (с 1).
  parentId     String?   @db.Uuid
  parent       Asset?    @relation("AssetPages", fields: [parentId], references: [id], onDelete: Cascade)
  pages        Asset[]   @relation("AssetPages")
  pageNumber   Int?
  originalName String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())

  @@index([ownerId])
  @@index([boardId])
  @@index([sha256])
}

// ---------------------------------------------------------------------
//  Библиотека шаблонов
// ---------------------------------------------------------------------

enum EducationLevel {
  SCHOOL
  OLYMPIAD
  UNIVERSITY
}

enum TemplateVisibility {
  /// Встроенный шаблон (поставляется с приложением, создаётся сидом).
  BUILTIN
  /// Виден только автору.
  PRIVATE
  /// Виден всем учителям.
  TEACHERS
  /// Виден выбранным учителям (TemplateShare).
  SELECTED
}

model Template {
  id          String             @id @default(uuid()) @db.Uuid
  /// Стабильный ключ встроенного шаблона, например "physics.mechanics.incline".
  builtinKey  String?            @unique @db.VarChar(120)
  title       String             @db.VarChar(300)
  description String?            @db.VarChar(2000)
  /// Раздел в формате "math.planimetry", "physics.optics" и т.п.
  section     String             @db.VarChar(120)
  level       EducationLevel
  tags        String[]
  visibility  TemplateVisibility @default(PRIVATE)
  authorId    String?            @db.Uuid
  author      User?              @relation("TemplateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Доска kind = TEMPLATE с содержимым шаблона.
  boardId     String             @unique @db.Uuid
  board       Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  usageCount  Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  shares TemplateShare[]

  @@index([section, level])
  @@index([visibility])
  @@index([authorId])
}

model TemplateShare {
  templateId String   @db.Uuid
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([templateId, userId])
}

// ---------------------------------------------------------------------
//  Журнал действий
// ---------------------------------------------------------------------

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_BLOCKED
  LOGOUT
  TOKEN_REUSE_DETECTED
  PASSWORD_CHANGED
  PASSWORD_RESET
  USER_CREATED
  USER_IMPORTED
  USER_UPDATED
  USER_BLOCKED
  USER_UNBLOCKED
  USER_DELETED
  CLASS_CREATED
  CLASS_UPDATED
  CLASS_DELETED
  CLASS_MEMBERS_CHANGED
  BOARD_CREATED
  BOARD_DELETED
  BOARD_ACCESS_CHANGED
  BOARD_MODE_CHANGED
  BOARD_VERSION_RESTORED
  BOARD_CLEARED
  ASSIGNMENT_CREATED
  TEMPLATE_SHARED
}

/// Журнал действий. Никогда не содержит паролей и токенов
/// (details проходит через функцию редактирования секретов).
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  action     AuditAction
  actorId    String?     @db.Uuid
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Логин на момент события — нужен для неудачных входов несуществующих
  /// пользователей и для истории удалённых аккаунтов.
  actorLogin String?     @db.VarChar(64)
  targetType String?     @db.VarChar(40)
  targetId   String?     @db.VarChar(64)
  ip         String?     @db.VarChar(64)
  userAgent  String?     @db.VarChar(400)
  details    Json        @default("{}")
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}
